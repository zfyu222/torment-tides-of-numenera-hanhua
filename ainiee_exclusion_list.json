[
  {
    "markers": "",
    "info": "方括号标记",
    "regex": "\\[[^\\[\\]\\n]{1,60}\\]"
  },
  {
    "markers": "",
    "info": ".NET/格式化占位符",
    "regex": "\\{\\d+(:[^{}\\n]*)?\\}"
  },
  {
    "markers": "",
    "info": "花括号命名变量/演出提示",
    "regex": "\\{[A-Za-z_][A-Za-z0-9_]*(?:=[^{}\\n]+)?\\}"
  },
  {
    "markers": "",
    "info": "实际尖括号渲染标签（排除 <No,> 等可见心灵对白）",
    "regex": "(?:<quad\\s+class=\"[A-Za-z0-9_-]+\">|</?a(?:\\s+name=\"[^\"]+\")?>)"
  },
  {
    "markers": "",
    "info": "printf 格式化符",
    "regex": "%(?:\\d+\\$)?[0-9.+#-]*[sdfoxXeEfgGcr%]"
  },
  {
    "markers": "",
    "info": "字面转义序列",
    "regex": "\\\\[nrt]"
  }
]
